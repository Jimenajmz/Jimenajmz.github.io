<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% set pageTitle = ('Jimena Jiménez · Art, photography, recipes and Menez Made' if page.url == '/' else (seoTitle or title) + ' · Jimena Jiménez') %}
    {% set pageDesc = description or summary or site.description %}
    {% set pageUrl = site.url + page.url %}
    {% set pageImage = (site.url + media[0].src) if (media and media[0].src and media[0].src.startsWith('/images/')) else '' %}
    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ pageDesc }}">
    <link rel="canonical" href="{{ pageUrl }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:title" content="{{ pageTitle }}">
    <meta property="og:description" content="{{ pageDesc }}">
    <meta property="og:url" content="{{ pageUrl }}">
    {% if pageImage %}<meta property="og:image" content="{{ pageImage }}">
    <meta name="twitter:card" content="summary_large_image">{% else %}<meta name="twitter:card" content="summary">{% endif %}
    {% set person = { "@type": "Person", "name": site.name, "url": site.url + "/", "sameAs": [site.instagram], "address": { "@type": "PostalAddress", "addressLocality": "Rochester", "addressRegion": "MN", "addressCountry": "US" } } %}
    {% set menezmade = { "@type": "Organization", "name": "Menez Made", "alternateName": ["MenezMade", "@MenezMade"], "url": site.url + "/projects/menezmade/", "description": "Handmade arts and crafts by Jimena Jiménez: sewn and crocheted plushies, pins, art prints and earrings.", "founder": person, "sameAs": [site.instagram] } %}
    {% set graph = [ { "@type": "WebSite", "name": site.name, "alternateName": "Menez Made", "url": site.url + "/" }, person, menezmade ] if (page.url == '/' or page.url == '/projects/menezmade/') else [ { "@type": "WebSite", "name": site.name, "url": site.url + "/" }, person ] %}
    <script type="application/ld+json">{{ { "@context": "https://schema.org", "@graph": graph } | dump | safe }}</script>
    <link rel="icon" type="image/png" sizes="32x32" href="/main/images/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500&family=Fraunces:opsz,wght@9..144,600&family=IBM+Plex+Mono:wght@400;500&family=Lora:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/brief.css">
</head>
<body>
    <header class="topbar">
        <div class="wrap">
            <a class="brand" href="/"><span class="hl">Jimena</span> Jiménez</a>
            <nav class="nav" aria-label="Sections">
                <a {% if page.url == '/' %}class="active" {% endif %}href="/">Home</a>
                <a {% if page.url.startsWith('/art/') %}class="active" {% endif %}href="/art/">Art</a>
                <a {% if page.url.startsWith('/photography/') %}class="active" {% endif %}href="/photography/">Photography</a>
                <a {% if page.url.startsWith('/about/') %}class="active" {% endif %}href="/about/">About me</a>
                <a {% if page.url.startsWith('/recipes/') %}class="active" {% endif %}href="/recipes/">Recipes</a>
                <a {% if page.url.startsWith('/blog/') %}class="active" {% endif %}href="/blog/">Blog</a>
                <a {% if page.url.startsWith('/projects/') %}class="active" {% endif %}href="/projects/">Projects</a>
            </nav>
        </div>
    </header>
    {% if page.url == '/' %}
    <div class="ticker" aria-hidden="true"><div class="ticker-track">{% for i in range(0, 12) %}<span>art</span>·<span>photography</span>·<span>recipes</span>·<span>writing</span>·<span>projects</span>·<span>made in Minnesota</span>·{% endfor %}</div></div>
    {% endif %}
    <main>
        <div class="wrap">
{{ content | safe }}
        </div>
    </main>
    <footer class="footer">
        <div class="wrap">
            <span>Jimena Jiménez · Rochester, Minnesota</span>
            <span><a href="https://www.instagram.com/menezmade/">Instagram @MenezMade</a> · <a href="/main/first-webpage.html">my first webpage</a></span>
        </div>
    </footer>
    <script src="/brief.js"></script>
</body>
</html>
