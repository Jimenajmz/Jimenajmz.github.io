<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" type="text/css" href="/main/styles/style.css">
    <link rel="stylesheet" type="text/css" href="/pages.css">
    <link href="https://fonts.googleapis.com/css?family=Lustria|Mate" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="icon" type="image/png" sizes="32x32" href="/main/images/favicon.png">
    <title>{{ title }} · JMAJMZ</title>
</head>
<body>
    <div id="snow-container"></div>
    <div class="title-container">
        <h1>{{ title }}</h1>
    </div>
    <div class="top">
        <div class="main-content">
            <div class="post page">
                {% if date and page.inputPath.includes('/posts/') %}<p class="meta">{{ date | niceDate }}</p>{% endif %}
                {% if image %}<img src="{{ image }}" alt="{{ title }}">{% endif %}
                {{ content | safe }}
            </div>
        </div>
        <div class="sidebar">
            <h2 class='navigation-title'>Navigations</h2>
            <div class='navi-links'>
                <a href="/main/main.html" title="Home">Home</a>
                <a href="/main/aboutme.html" title="About Me">About Me</a>
                <a {% if page.url.startsWith('/recipes/') %}class="active" {% endif %}href="/recipes/" title="Recipes">Recipes</a>
                <a {% if page.url.startsWith('/art/') %}class="active" {% endif %}href="/art/" title="Art">Art</a>
                <a {% if page.url.startsWith('/posts/') %}class="active" {% endif %}href="/posts/" title="Blog">Blog</a>
            </div>
        </div>
    </div>
    <script src="/main/main.js"></script>
</body>
</html>
