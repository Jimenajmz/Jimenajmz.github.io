---
layout: base.njk
---
<div class="page-head"><h1>{{ title }}</h1></div>
<div class="about">
    <div class="body">
{{ content | safe }}
    </div>
    <div class="photos">
        {#- The photos here: first the Med City Makerspace picture from Projects, then every Photography post tagged "me", newest first.
            Only the Photography ones get the "come from the photography tab" note. -#}
        {% set media = [] %}
        {% for p in collections.projects %}{% if p.fileSlug == 'med-city-makerspace' and p.data.photos and p.data.photos[0] %}
            {% set _ = media.push({ src: p.data.photos[0].src, alt: p.data.photos[0].alt, caption: p.data.title }) %}
        {% endif %}{% endfor %}
        {% for item in collections.photography %}{% if 'me' in (item | tagsOf) and item.data.media and item.data.media[0] %}
            {% set _ = media.push({ src: item.data.media[0].src, alt: item.data.media[0].alt, caption: item.data.title, note: 'These photos come from the <a href="/photography/?tag=me">photography tab</a>.' }) %}
        {% endif %}{% endfor %}
        {% for ph in photos %}{% set _ = media.push({ src: ph.src, alt: ph.alt, caption: ph.caption }) %}{% endfor %}
        {% set label = 'Photos of Jimena' %}
        {% include "viewer.njk" %}
    </div>
</div>
