---
layout: base.njk
---
<article class="reading recipe">
    <div class="page-head">
        <p class="meta"><a href="/recipes/">recipes</a>{% if category %} · {{ category }}{% endif %}</p>
        <h1>{{ title }}</h1>
        {% if draft %}<p class="pencil">draft, still to be filled in</p>{% endif %}
    </div>
    <div class="recipe-meta">
        {% if prep %}<span><b>Prep</b>{{ prep }}</span>{% endif %}
        {% if total %}<span><b>Total</b>{{ total }}</span>{% endif %}
        {% if difficulty %}<span><b>Difficulty</b>{{ difficulty }}</span>{% endif %}
        {% if rating %}<span><b>My rating</b>{{ rating | stars }}</span>{% endif %}
    </div>
    {% if images and images.length %}<div class="recipe-photos">{% for im in images %}<img src="{{ im.src }}" alt="{{ im.alt or title }}">{% endfor %}</div>{% endif %}
    <div class="body">
{{ content | safe }}
    </div>
</article>
